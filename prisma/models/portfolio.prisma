model Profile {
  userId        String       @id
  user          Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String       @default("")
  title         String       @default("")
  location      String       @default("")
  experience    String       @default("")
  description   String       @default("")
  brief         String       @default("")
  aboutImage    String?
  aboutImageAlt String       @default("")
  aboutText     String       @default("")
  githubUrl     String?
  linkedinUrl   String?
  email         String?
  active        Boolean      @default(true)
  messages      Messages[]
}

model Messages {
  id        String    @id @default(uuid(7)) @db.Uuid
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime  @default(now())
  readAt    DateTime?
}
